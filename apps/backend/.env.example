PORT=3000
DATABASE_URL=postgres://user:pass@ep-cool-neon-db.neon.tech/neondb

# Email provider (pick ONE — Resend is recommended)
# Resend: https://resend.com — get an API key from the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM=Digital Logbook <onboarding@resend.dev>

# Gmail SMTP (alternative)
# Get an App Password: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# JWT secret for auth tokens.
# REQUIRED in production — the server refuses to start without it.
# Outside production the server generates one per process, so sessions end
# at every restart until this is set.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend URL (for verification/reset links in emails)
APP_URL=http://localhost:5173

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
