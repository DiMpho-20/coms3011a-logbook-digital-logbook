PORT=3000
DATABASE_URL=postgres://user:pass@ep-cool-neon-db.neon.tech/neondb

# Email provider (pick ONE — Resend is recommended)
# Resend: https://resend.com — get an API key from the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM=Digital Logbook <onboarding@resend.dev>

# Gmail SMTP (alternative)
# Get an App Password: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# JWT secret for auth tokens.
# REQUIRED in production — the server refuses to start without it.
# Outside production the server generates one per process, so sessions end
# at every restart until this is set.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend URL (for links in emails and the Google Calendar redirect back to the Calendar page)
APP_URL=http://localhost:5173

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Required when Google Calendar is configured. Use a strong, unique secret;
# it encrypts Calendar access and refresh tokens before they are stored.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Rate limiting (BUG-003) ────────────────────────────────────────────
# Windows are in minutes; each MAX is requests per window per IP.
# Defaults shown. Omit any of these to take the default.
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_2FA_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60

# Set to "true" to switch rate limiting off entirely. Unset, it is off only
# under NODE_ENV=test.
# RATE_LIMIT_DISABLED=

# How many proxy hops to trust when reading the client address. Render puts
# one proxy in front of the app, so production wants 1. Defaults to 1 in
# production and 0 everywhere else.
# TRUST_PROXY_HOPS=
