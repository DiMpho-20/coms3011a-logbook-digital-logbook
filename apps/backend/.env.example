PORT=3000
DATABASE_URL=postgres://user:pass@ep-cool-neon-db.neon.tech/neondb
# Production: the same database through Neon's direct endpoint (the host
# without "-pooler"). Only Prisma migrations use it — through the pooler
# their advisory lock gets stuck and later deploys time out. Leave unset
# locally and in CI; DATABASE_URL is used instead.
# DIRECT_URL=postgres://user:pass@ep-cool-neon-db.neon.tech/neondb

# Email provider (pick ONE — Resend is recommended)
# Resend: https://resend.com — get an API key from the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM=Digital Logbook <onboarding@resend.dev>

# Gmail SMTP (alternative)
# Get an App Password: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# JWT secret for auth tokens.
# REQUIRED in production — the server refuses to start without it.
# Outside production the server generates one per process, so sessions end
# at every restart until this is set.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend URL (for links in emails and the Google Calendar redirect back to the Calendar page)
APP_URL=http://localhost:5173

# ── Cross-origin access ────────────────────────────────────────────────
# Comma-separated list of exact browser origins allowed to call this API.
# Required in production: unset there, every cross-origin browser request is
# refused, and the startup log says so. Outside production the Vite dev ports
# (5173 and 5174) are granted anyway, so local development needs nothing here.
CORS_ORIGINS=http://localhost:5173
# Optional pattern for hosts that cannot be listed in advance, such as
# Cloudflare Pages preview deployments. Off unless set. A pattern that does
# not compile is ignored with a warning rather than stopping the server.
# CORS_ORIGIN_PATTERN=^https://[a-z0-9]+\.your-project\.pages\.dev$

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Required when Google Calendar is configured. Use a strong, unique secret;
# it encrypts Calendar access and refresh tokens before they are stored.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Two-factor authentication (BUG-004) ────────────────────────────────
# Required before anyone can enable 2FA; it encrypts TOTP secrets at rest.
# /api/auth/2fa/setup returns 503 while this is unset rather than storing a
# secret in plaintext. Existing plaintext secrets keep working and are
# re-encrypted the next time their owner signs in.
#
# Changing or losing this key makes every stored secret unreadable: those
# users will need to disable and re-enrol 2FA, or sign in with a recovery
# code. Treat it like JWT_SECRET — set it once, back it up, never rotate it
# casually.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# ── Rate limiting (BUG-003) ────────────────────────────────────────────
# Windows are in minutes; each MAX is requests per window per IP.
# Defaults shown. Omit any of these to take the default.
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_2FA_MAX=10
RATE_LIMIT_2FA_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60

# Set to "true" to switch rate limiting off entirely. Unset, it is off only
# under NODE_ENV=test.
# RATE_LIMIT_DISABLED=

# How many proxy hops to trust when reading the client address. Render puts
# one proxy in front of the app, so production wants 1. Defaults to 1 in
# production and 0 everywhere else.
# TRUST_PROXY_HOPS=

# ── Push notifications for reminders ───────────────────────────────────
# Lets the server notify students' devices when a reminder falls due, even
# with the app closed. Leave unset to keep reminders in-app only.
# Generate a pair once with:  npx web-push generate-vapid-keys
# Changing the keys cuts off every existing device subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL. Defaults to APP_URL
# when that is https.
# VAPID_SUBJECT=mailto:you@example.com

# ── Help assistant ─────────────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com (Get API key). The free
# tier is enough. Leave unset to switch the assistant off: its endpoint then
# answers 503 and the chat button explains it is unavailable.
GEMINI_API_KEY=
# Comma-separated models, tried in order when one is busy. Optional.
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.1-flash-lite
# Questions per window per IP. Defaults shown.
RATE_LIMIT_ASSISTANT_MAX=30
RATE_LIMIT_ASSISTANT_WINDOW_MINUTES=10
