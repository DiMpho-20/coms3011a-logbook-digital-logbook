generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum EntryFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  TAGS
  CHECKLIST
  LINK
  REFERENCE
  COMPUTED
}

// --- USER ENTITY (Person 1) ---

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  email                   String            @unique @db.VarChar(255)
  passwordHash            String            @map("password_hash") @db.VarChar(255)
  fullName                String            @map("full_name") @db.VarChar(255)
  isEmailVerified         Boolean           @default(false) @map("is_email_verified")
  emailVerificationToken  String?           @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiry DateTime?         @map("email_verification_expiry")
  twoFactorSecret         String?           @map("two_factor_secret") @db.VarChar(255)
  isTwoFactorEnabled      Boolean           @default(false) @map("is_two_factor_enabled")
  scheduledDeletionAt     DateTime?         @map("scheduled_deletion_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  // Relations
  passwordResets          PasswordReset[]
  projects                Project[]

  @@map("users")
}

// --- PASSWORD RESET ENTITY (Person 1) ---

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// --- PROJECT ENTITY ---

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String        @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryFields EntryField[]
  formatVersions EntryFormatVersion[]
  entries     LogbookEntry[]

  @@unique([userId, name])
  @@map("projects")
}

// --- ENTRY FIELDS ---

model EntryField {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  name      String         @db.VarChar(255)
  type      EntryFieldType
  required  Boolean        @default(false)
  formula   String?        @db.Text
  archivedAt DateTime?     @map("archived_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    EntryValue[]

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("entry_fields")
}

// --- LOGBOOK ENTRIES ---

model LogbookEntry {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  durationMinutes Int          @default(0) @map("duration_minutes")
  entryDate       DateTime?    @map("entry_date")
  dueDate         DateTime?    @map("due_date")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  formatVersionId String?      @map("format_version_id") @db.Uuid

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  EntryValue[]
  formatVersion EntryFormatVersion? @relation(fields: [formatVersionId], references: [id], onDelete: SetNull)

  @@map("logbook_entries")
}

// Immutable snapshots let entries retain the format that was current when
// they were created, even after fields are renamed or retired.
model EntryFormatVersion {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int
  fields    Json
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries LogbookEntry[]

  @@unique([projectId, version])
  @@map("entry_format_versions")
}

// --- ENTRY VALUES ---

model EntryValue {
  id      String       @id @default(uuid()) @db.Uuid
  entryId String       @map("entry_id") @db.Uuid
  fieldId String       @map("field_id") @db.Uuid
  value   String       @db.Text

  entry   LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  field   EntryField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([entryId, fieldId])
  @@map("entry_values")
}
