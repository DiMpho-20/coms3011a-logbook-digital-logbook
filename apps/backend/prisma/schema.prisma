generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum EntryFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  TAGS
  CHECKLIST
  LINK
  REFERENCE
  COMPUTED
}

enum EntryStatus {
  OPEN
  DONE
}

// --- USER ENTITY (Person 1) ---

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  email                   String            @unique @db.VarChar(255)
  passwordHash            String            @map("password_hash") @db.VarChar(255)
  fullName                String            @map("full_name") @db.VarChar(255)
  isEmailVerified         Boolean           @default(false) @map("is_email_verified")
  emailVerificationToken  String?           @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiry DateTime?         @map("email_verification_expiry")
  twoFactorSecret         String?           @map("two_factor_secret") @db.VarChar(255)
  isTwoFactorEnabled      Boolean           @default(false) @map("is_two_factor_enabled")
  scheduledDeletionAt     DateTime?         @map("scheduled_deletion_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  // Relations
  passwordResets          PasswordReset[]
  projects                Project[]
  tags                    Tag[]
  googleCalendarConnection GoogleCalendarConnection?
  customStatistics        CustomStatistic[]

  @@map("users")
}

// --- PASSWORD RESET ENTITY (Person 1) ---

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// --- PROJECT ENTITY ---

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String        @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryFields EntryField[]
  formatVersions EntryFormatVersion[]
  entries     LogbookEntry[]
  tags        ProjectTag[]
  customStatistics CustomStatistic[]

  @@unique([userId, name])
  @@map("projects")
}

// --- ENTRY FIELDS ---

model EntryField {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  name      String         @db.VarChar(255)
  type      EntryFieldType
  required  Boolean        @default(false)
  formula   String?        @db.Text
  archivedAt DateTime?     @map("archived_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    EntryValue[]

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("entry_fields")
}

// --- LOGBOOK ENTRIES ---

model LogbookEntry {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  durationMinutes Int          @default(0) @map("duration_minutes")
  entryDate       DateTime?    @map("entry_date")
  dueDate         DateTime?    @map("due_date")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  status          EntryStatus  @default(OPEN)
  completedAt     DateTime?    @map("completed_at")
  formatVersionId String?      @map("format_version_id") @db.Uuid
  // Set when the entry is moved to the archive (US30); null means active.
  archivedAt      DateTime?    @map("archived_at")


  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  EntryValue[]
  formatVersion EntryFormatVersion? @relation(fields: [formatVersionId], references: [id], onDelete: SetNull)
  tags    EntryTag[]
  versions EntryVersion[]

  @@map("logbook_entries")
}

// --- ENTRY VERSIONS (US20-22) ---
// One row per saved state of an entry, written when it is created, edited or
// restored. Rows are never updated or deleted, so an edit can't overwrite
// what the entry said before. `snapshot` holds the entry exactly as the API
// returned it at that point, field names included, so a historical version
// still reads correctly after the project's fields are renamed or removed.

model EntryVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  entryId             String   @map("entry_id") @db.Uuid
  version             Int
  // CREATED, UPDATED or RESTORED
  reason              String   @db.VarChar(20)
  restoredFromVersion Int?     @map("restored_from_version")
  snapshot            Json
  createdAt           DateTime @default(now()) @map("created_at")

  entry LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@map("entry_versions")
}

// Immutable snapshots let entries retain the format that was current when
// they were created, even after fields are renamed or retired.
model EntryFormatVersion {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int
  fields    Json
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries LogbookEntry[]

  @@unique([projectId, version])
  @@map("entry_format_versions")
}

// --- ENTRY VALUES ---

model EntryValue {
  id      String       @id @default(uuid()) @db.Uuid
  entryId String       @map("entry_id") @db.Uuid
  fieldId String       @map("field_id") @db.Uuid
  value   String       @db.Text

  entry   LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  field   EntryField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([entryId, fieldId])
  @@map("entry_values")
}

// --- TAGS ---
// A lightweight, user-scoped label that can be attached to any number of the
// user's own projects and entries. Independent of the per-project custom
// entry-field system: tags apply uniformly, with no format to define first.

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectTag[]
  entries  EntryTag[]

  @@unique([userId, name])
  @@map("tags")
}

model ProjectTag {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model EntryTag {
  entryId String @map("entry_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  entry LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag   Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@map("entry_tags")
}

model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique @db.Uuid
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// US17 — a statistic the owner wrote themselves. Only the definition is
/// stored; the value is worked out from current entries every time it is
/// read, so a saved statistic keeps up with the data instead of going stale.
model CustomStatistic {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  name       String   @db.VarChar(100)
  /// The exact expression the owner saved, in US16 syntax.
  expression String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Unique per project rather than per user: a project has exactly one
  /// owner, so this is the same guarantee with one less column to drift.
  @@unique([projectId, name])
  @@map("custom_statistics")
}
